{
  "manifest_version": 3,
  "name": "Savoir",
  "version": "0.2.0",
  "version_name": "0.2.0 beta 1",
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "description": "Résumé et discussion avec votre compte ChatGPT, à côté de votre vidéo YouTube. Aucun modèle local.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "src/popup/index.html", "default_title": "Savoir" },
  "options_page": "src/options/index.html",
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*", "https://www.youtube-nocookie.com/embed/*"], "js": ["content.js"] }],
  "web_accessible_resources": [{ "resources": ["src/panel/index.html", "assets/*"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.youtube-nocookie.com/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
