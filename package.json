{
  "name": "savoir",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Comprendre une vidéo YouTube, sans quitter la vidéo.",
  "license": "MIT",
  "repository": {"type":"git","url":"https://github.com/A-Arnaud/Savoir.git"},
  "scripts": {
    "test": "vitest run --maxWorkers=2",
    "test:unit": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "build": "node tools/compile-validators.mjs --check && node tools/build-extension.mjs",
    "contracts:generate": "uv run --project services/native_host python tools/export-contracts.py && node tools/compile-validators.mjs",
    "test:e2e": "playwright test -c playwright.native.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",

    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ajv": "8.20.0",

    "json-schema-to-ts": "3.1.1",

    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
